[Unit]
Description=secfin weekly filing-index refresh + disclosure stats
Wants=network-online.target
After=network-online.target docker.service

[Service]
Type=oneshot
User=secfin
WorkingDirectory=/opt/secfin
ExecStart=/opt/secfin/deploy/scripts/run-disclosure-stats.sh
# ~35 min of throttled /submissions/ reads for ~17k issuers, plus seconds for the aggregation.
TimeoutStartSec=7200
