[Unit]
Description=secfin per-company open-market insider ratios (Insider view peer strip)
Wants=network-online.target
After=network-online.target docker.service

[Service]
Type=oneshot
User=secfin
WorkingDirectory=/opt/secfin
ExecStart=/opt/secfin/deploy/scripts/run-insider-peer-ratio.sh
# Bound runtime so a stuck batch cannot still be holding the DB when the backup fires at
# 07:00. The aggregation itself is one DuckDB pass over the cached insider rows (seconds on
# a 438k-row corpus); the headroom is for the image build the runner does on a cold droplet.
TimeoutStartSec=1800
