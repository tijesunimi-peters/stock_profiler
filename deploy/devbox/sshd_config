# sshd for the devbox container. Key-only, one user, reachable on loopback and through the
# `ngrok` service. See deploy/devbox/Dockerfile for what this image is and is not.

Port 22
ListenAddress 0.0.0.0

# On the mounted volume, generated by the entrypoint on first start -- never baked into the
# image (that publishes a private key) and never regenerated per start (that would fail the
# client's known_hosts check on every rebuild, training you to ignore the one warning that
# actually matters).
HostKey /etc/ssh/keys/ssh_host_ed25519_key
HostKey /etc/ssh/keys/ssh_host_rsa_key

PermitRootLogin no
AllowUsers dev

PubkeyAuthentication yes
AuthorizedKeysFile .ssh/authorized_keys

PasswordAuthentication no
PermitEmptyPasswords no
KbdInteractiveAuthentication no
UsePAM no

# 6, not the host sshd's 4. ssh offers each identity in turn and every offer burns an attempt,
# so a laptop with three authorized keys plus a loaded agent can trip a limit of 4 before it
# reaches the right one -- and the error ("Too many authentication failures") names the symptom,
# not the cause. Prefer `IdentitiesOnly yes` in the client config; this is the safety margin.
MaxAuthTries 6

# Load-bearing, not a default left in place. `ssh -L 8000:api:8000` is how the app is reached,
# and the forward is resolved from THIS side -- `api` is a Docker DNS name on the compose
# network. Without this the whole access model stops working.
AllowTcpForwarding yes
# Forwards stay bound to the client's own loopback; nothing this container forwards is offered
# to the network.
GatewayPorts no

X11Forwarding no
PermitTunnel no
AllowAgentForwarding yes

# tmux sessions are meant to outlive a coffee break. NAT and the tunnel edge both drop idle
# TCP, so the server pings rather than letting a silent connection rot.
ClientAliveInterval 30
ClientAliveCountMax 6

# VERBOSE, not the default INFO. At INFO a failed login logs only "Connection closed [preauth]"
# -- which is indistinguishable between "the client offered no key we accept", "the client ran
# out of identities to try" and "the client gave up". VERBOSE logs the FINGERPRINT of every key
# offered, which turns "it does not work" into "it offered these three, none is authorised".
# The box is reachable from the internet, so this is also the log you would want after the fact.
LogLevel VERBOSE

PrintMotd no
AcceptEnv LANG LC_*
Subsystem sftp /usr/lib/openssh/sftp-server
