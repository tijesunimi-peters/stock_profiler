{
  "name": "@clearyfi/design-prototype",
  "version": "0.1.0",
  "private": true,
  "description": "ClearyFi design system as React components — the warm paper-terminal vocabulary (tokens, status chips, metric cards, sector analytics primitives) used by the SEC filings product.",
  "type": "module",
  "module": "./dist/index.js",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/clearyfi.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-assets.mjs",
    "clean": "rm -rf dist app-dist",
    "dev": "node scripts/copy-assets.mjs && vite",
    "app:build": "node scripts/copy-assets.mjs && vite build",
    "app:preview": "vite preview --port 5174 --strictPort",
    "app:typecheck": "tsc -p app/tsconfig.json --noEmit"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@types/d3": "^7.4.3",
    "@types/node": "^26.1.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.7.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.21"
  },
  "dependencies": {
    "d3": "^7.9.0"
  }
}
